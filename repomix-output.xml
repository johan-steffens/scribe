        .join("deep")
        .join("sync-state.json");

    let state = SyncState::default();
    state.save(&path).expect("save should succeed");

    assert!(path.exists());
    let loaded = SyncState::load(&path);
    assert!(loaded.last_error.is_none()); // Verify it loaded correctly
}

