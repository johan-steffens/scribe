/// Returns the MCP config snippet for `OpenCode` (paste to `opencode.json`).
fn opencode_mcp_snippet() -> &'static str {
    r#"{
  "mcp": {
    "scribe": {
      "type": "local",
      "command": ["scribe", "mcp"],
      "enabled": true
    }
  }
}"#
