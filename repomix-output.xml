}

/// Configures the JSONBin.io sync provider.
///
/// # Errors
///
/// Returns an error if the key prompt fails or the keychain write fails.
fn configure_jsonbin() -> anyhow::Result<()> {
    let key = rpassword::prompt_password("JSONBin.io access key: ")?;
